	</column>
	<constraint name="Sucursal_pk" type="pk-constr" table="public.&quot;Sucursal&quot;">
		<columns names="id_sucursal" ref-type="src-columns"/>
	</constraint>
</table>

<table name="Fabrica" layers="0" collapse-mode="2" max-obj-count="2" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="1860" y="1000"/>
	<column name="id_fabrica" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="direccion" not-null="true">
		<type name="text" length="0"/>
	</column>
	<constraint name="Fabrica_pk" type="pk-constr" table="public.&quot;Fabrica&quot;">
