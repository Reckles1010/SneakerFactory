</table>

<table name="Almacen" layers="0" collapse-mode="2" max-obj-count="2" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="1860" y="700"/>
	<column name="id_almacen" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="direccion" not-null="true">
		<type name="text" length="0"/>
	</column>
	<constraint name="Almacen_pk" type="pk-constr" table="public.&quot;Almacen&quot;">
		<columns names="id_almacen" ref-type="src-columns"/>
	</constraint>
</table>

<relationship name="Clientes_has_many_Pedido" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#3ef24d"
	 src-table="public.&quot;Clientes&quot;"
	 dst-table="public.&quot;Pedido&quot;"
	 src-required="false" dst-required="false"/>

<relationship name="Pedido_has_one_Linea de pedido" type="rel11" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#dcddfd"
	 src-table="public.&quot;Linea de pedido&quot;"
	 dst-table="public.&quot;Pedido&quot;"
	 src-required="false" dst-required="false"/>

<relationship name="many_Fabrica_has_many_Almacen" type="relnn" layers="0"
	 src-col-pattern="{sc}_{st}" dst-col-pattern="{sc}_{dt}"
	 pk-pattern="{gt}_pk" uq-pattern="{gt}_uq"
	 src-fk-pattern="{st}_fk" dst-fk-pattern="{dt}_fk"
	 pk-col-pattern="id"
	 custom-color="#17596b"
	 src-table="public.&quot;Fabrica&quot;"
	 dst-table="public.&quot;Almacen&quot;"
	 src-required="false" dst-required="false"
	 table-name="many_Fabrica_has_many_Almacen"/>

<table name="Modelo" layers="0" collapse-mode="2" max-obj-count="4" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="560" y="920"/>
	<column name="id_modelo" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="nombre" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="precio" not-null="true">
		<type name="numeric" length="0"/>
	</column>
	<constraint name="Modelo_pk" type="pk-constr" table="public.&quot;Modelo&quot;">
		<columns names="id_modelo" ref-type="src-columns"/>
	</constraint>
	<constraint name="Comprobación precio" type="ck-constr" table="public.&quot;Modelo&quot;">
			<expression><![CDATA[precio>0]]></expression>
	</constraint>

	<customidxs object-type="column">
		<object name="id_producto_Productos" index="3"/>
	</customidxs>

	<customidxs object-type="constraint">
		<object name="Productos_fk" index="0"/>
	</customidxs>
</table>

<relationship name="Productos_has_many_Modelo" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#c6f2f7"
	 src-table="public.&quot;Productos&quot;"
	 dst-table="public.&quot;Modelo&quot;"
	 src-required="false" dst-required="false"/>

<relationship name="Trabajador_has_many_Pedido" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#4b61a7"
	 src-table="public.&quot;Trabajador&quot;"
	 dst-table="public.&quot;Pedido&quot;"
	 src-required="false" dst-required="false"/>

<relationship name="Modelo_has_many_Pedido" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#198b89"
	 src-table="public.&quot;Modelo&quot;"
	 dst-table="public.&quot;Pedido&quot;"
	 src-required="true" dst-required="false"/>

<relationship name="Sucursal_has_many_Trabajador" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#ac59fd"
	 src-table="public.&quot;Sucursal&quot;"
	 dst-table="public.&quot;Trabajador&quot;"
	 src-required="true" dst-required="false"/>

<relationship name="Sucursal_has_one_Almacen" type="rel11" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#47fbf2"
	 src-table="public.&quot;Almacen&quot;"
	 dst-table="public.&quot;Sucursal&quot;"
	 src-required="false" dst-required="false"/>

</dbmodel>
