<dbmodel pgmodeler-ver="0.9.4" use-changelog="false" last-position="0,0" last-zoom="0.7" max-obj-count="10"
	 default-schema="public" default-owner="postgres"
	 layers="Default layer"
	 active-layers="0"
	 layer-name-colors="#000000"
	 layer-rect-colors="#b4b4b4"
	 show-layer-names="false" show-layer-rects="false">
<database name="new_database" is-template="false" allow-conns="true">
</database>

<schema name="public" layers="0" fill-color="#e1e1e1" sql-disabled="true">
</schema>

<table name="Clientes" layers="0" collapse-mode="1" max-obj-count="6" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="20" y="400"/>
	<column name="id_cliente" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="dni">
		<type name="text" length="0"/>
	</column>
	<column name="nombre">
		<type name="text" length="0"/>
	</column>
	<column name="direccion" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="telefono">
		<type name="numeric" length="0"/>
	</column>
	<constraint name="Clientes_pk" type="pk-constr" table="public.&quot;Clientes&quot;">
		<columns names="id_cliente" ref-type="src-columns"/>
	</constraint>
</table>

<table name="Productos" layers="0" collapse-mode="2" max-obj-count="2" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="0" y="920"/>
	<column name="id_producto" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="tipo" not-null="true">
		<type name="text" length="0"/>
	</column>
	<constraint name="Productos_pk" type="pk-constr" table="public.&quot;Productos&quot;">
		<columns names="id_producto" ref-type="src-columns"/>
	</constraint>
</table>

<table name="Pedido" layers="0" collapse-mode="2" max-obj-count="9" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="540" y="400"/>
	<column name="id_pedido" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="tipo" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="estado" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="descuento" not-null="true">
		<type name="boolean" length="0"/>
	</column>
	<constraint name="Pedido_pk" type="pk-constr" table="public.&quot;Pedido&quot;">
		<columns names="id_pedido" ref-type="src-columns"/>
	</constraint>

	<customidxs object-type="column">
		<object name="id_cliente_Clientes" index="7"/>
		<object name="id_linea_Linea de pedido" index="4"/>
		<object name="id_modelo_Modelo" index="5"/>
		<object name="id_trabajador_Trabajador" index="6"/>
	</customidxs>

	<customidxs object-type="constraint">
		<object name="Clientes_fk" index="1"/>
		<object name="Linea de pedido_fk" index="2"/>
		<object name="Modelo_fk" index="5"/>
		<object name="Pedido_uq" index="3"/>
		<object name="Trabajador_fk" index="4"/>
	</customidxs>
</table>

<table name="Linea de pedido" layers="0" collapse-mode="2" max-obj-count="7" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="560" y="120"/>
	<column name="id_linea" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="talla" not-null="true">
		<type name="numeric" length="0"/>
	</column>
	<column name="colorBase" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="colorPanel">
		<type name="text" length="0"/>
	</column>
	<column name="colorSuela">
		<type name="text" length="0"/>
	</column>
	<column name="colorCordones">
		<type name="text" length="0"/>
	</column>
	<constraint name="Linea de pedido_pk" type="pk-constr" table="public.&quot;Linea de pedido&quot;">
		<columns names="id_linea" ref-type="src-columns"/>
	</constraint>
	<constraint name="Comprobación talla" type="ck-constr" table="public.&quot;Linea de pedido&quot;">
			<expression><![CDATA[talla>0]]></expression>
	</constraint>
</table>

<table name="Trabajador" layers="0" collapse-mode="2" max-obj-count="4" z-value="0">
	<schema name="public"/>
