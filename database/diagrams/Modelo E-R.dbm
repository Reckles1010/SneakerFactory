	<column name="nombre" not-null="true">
		<type name="text" length="0"/>
	</column>
	<constraint name="Trabajador_pk" type="pk-constr" table="public.&quot;Trabajador&quot;">
		<columns names="id_trabajador" ref-type="src-columns"/>
	</constraint>
</table>

<table name="Sucursal" layers="0" collapse-mode="2" max-obj-count="3" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="1840" y="400"/>
	<column name="id_sucursal" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="direccion" not-null="true">
